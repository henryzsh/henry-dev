---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/base.css";

interface Props {
  titulo: string;
  descricao: string;
  atual: "home" | "blog" | "sobre" | "outra";
  tipo?: "website" | "article";
  dados?: object;
  publicado?: Date;
  semIndexar?: boolean;
}
const { titulo, descricao, atual, tipo = "website", dados, publicado, semIndexar = false } = Astro.props;
const canonico = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL("/og-image.png", Astro.site);
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titulo}</title>
<meta name="description" content={descricao}>
{!semIndexar && <link rel="canonical" href={canonico}>}
{semIndexar && <meta name="robots" content="noindex">}
<meta property="og:type" content={tipo}>
<meta property="og:site_name" content="Henry Kauã">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descricao}>
<meta property="og:url" content={canonico}>
<meta property="og:image" content={imagem}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Henry Kauã, desenvolvedor em Fortaleza">
{publicado && <meta property="article:published_time" content={publicado.toISOString()}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="author" content="Henry Kauã">
<meta name="theme-color" content="#f8f5ed">
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48">
<link rel="icon" type="image/png" href="/favicon-32.png?v=2" sizes="32x32">
<link rel="icon" type="image/png" href="/icon-192.png?v=2" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<link rel="alternate" type="application/rss+xml" title="Henry Kauã" href="/rss.xml">
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
{dados && <script type="application/ld+json" set:html={JSON.stringify(dados).replace(/</g, "\\u003c")} />}
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="marca" viewBox="0 0 128 128"><g transform="rotate(-9 64 66)"><rect x="16" y="36" width="88" height="76" rx="18" fill="var(--logo-side)" stroke="var(--logo-line)" stroke-width="6" stroke-linejoin="round"/><rect x="24" y="16" width="80" height="72" rx="18" fill="var(--logo-face)" stroke="var(--logo-line)" stroke-width="6" stroke-linejoin="round"/><path d="M46 36h9v12.5h18V36h9v32h-9V57.5H55V68h-9z" fill="var(--logo-h)"/></g></symbol><symbol id="marca-sm" viewBox="0 0 128 128"><g transform="translate(-1.7 -2.5) rotate(-9 64 66)"><rect x="16" y="42" width="88" height="76" rx="20" fill="var(--logo-side)" stroke="var(--logo-line)" stroke-width="8" stroke-linejoin="round"/><rect x="24" y="14" width="80" height="74" rx="20" fill="var(--logo-face)" stroke="var(--logo-line)" stroke-width="8" stroke-linejoin="round"/><path d="M40 28h14v16h20V28h14v44H74V56H54v16H40z" fill="var(--logo-h)"/></g></symbol></svg>
<Header atual={atual} />
<slot />
<Footer atual={atual} />
<script>
  // Marca no menu a seção da home que está na tela.
  const links = document.querySelectorAll<HTMLAnchorElement>('.links a[href^="#"]');
  if (links.length && "IntersectionObserver" in window) {
    const porId = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => porId.set(a.hash.slice(1), a));
    const io = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.removeAttribute("aria-current"));
          porId.get(e.target.id)?.setAttribute("aria-current", "true");
        }),
      { rootMargin: "-35% 0px -55% 0px" },
    );
    porId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>
</body>
</html>
