---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { pessoa, migalhas } from "../../data/site";
import { linkWhatsapp } from "../../data/links";
import "../../styles/blog.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = Astro.site!.origin;
const url = `${site}/blog/${post.id}/`;
const dados = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: post.data.pubDate.toISOString(),
      inLanguage: "pt-BR",
      articleSection: post.data.categoria,
      image: `${site}/og-image.png`,
      mainEntityOfPage: url,
      author: pessoa(site),
      publisher: { "@id": `${site}/#henry` },
    },
    migalhas(site, [["Início", "/"], ["Blog", "/blog/"], [post.data.title, `/blog/${post.id}/`]]),
  ],
};
const dia = post.data.pubDate.toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base titulo={`${post.data.title} · Henry Kauã`} descricao={post.data.description} atual="blog" tipo="article" dados={dados} publicado={post.data.pubDate}>
<main id="conteudo" class="gut w"><article class="art">
<a class="volta" href="/blog/">← Todos os textos</a>
<div class="meta"><span class="chip">{post.data.categoria}</span><span>{dia}</span><span>{post.data.leitura}</span></div>
<h1>{post.data.title}</h1>
<div class="corpo"><Content /></div>
<div class="caixa"><h2>Quer ver como foi feito?</h2><p>O Movimento tem uma página com o case completo, com as alternativas que avaliei, como validei os números e as decisões que tomei.</p><div class="acoes"><a class="btn" href="/movimento/">Ver o case do Movimento</a><a class="btn btn-ghost" href={linkWhatsapp("Olá, Henry! Li seu blog e quero conversar.")} target="_blank" rel="noopener">Falar comigo</a></div></div>
<p class="autor">Escrito por Henry Kauã, desenvolvedor em Fortaleza.</p>
</article></main>
</Base>
