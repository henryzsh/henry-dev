---
import Base from "../layouts/Base.astro";
import Movimento from "../components/home/Movimento.astro";
import { migalhas } from "../data/site";
import "../styles/home.css";

const site = Astro.site!.origin;
const dados = { "@context": "https://schema.org", ...migalhas(site, [["Início", "/"], ["Movimento", "/movimento/"]]) };
---
<Base titulo="Movimento · Henry Kauã" descricao="Analytics que criei do zero para os sites dos meus clientes: sem cookie, sem custo mensal e com o número que importa pro dono do negócio." atual="outra" dados={dados}>
<main id="conteudo" class="dv gut w">
<a class="volta" href="/#projetos">← Projetos</a>
<Movimento />
</main>
</Base>
