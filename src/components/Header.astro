---
import Marca from "./Marca.astro";
import { navegacao, type Atual } from "../data/links";
interface Props { atual: Atual }
const { atual } = Astro.props;
const a = atual === "home" ? "" : "/";
---
<header class="nav"><div class="nav-in gut w">
  <Marca href={a + "#inicio"} rotulo="Henry Kauã, início" />
  <nav class="links" aria-label="Seções">{navegacao.map(([nome, destino]) => <a href={destino.startsWith("#") ? a + destino : destino} aria-current={atual === nome.toLowerCase() ? "true" : undefined}>{nome}</a>)}</nav>
</div></header>
