---
import Marca from "./Marca.astro";
import { email, github, linkedin, navegacao, telefone, telefoneLink, type Atual } from "../data/links";
interface Props { atual: Atual }
const { atual } = Astro.props;
const a = atual === "home" ? "" : "/";
---
<footer><div class="gut w">
  <div class="foot">
    <div class="f1"><Marca href={a + "#inicio"} rotulo="Henry Kauã, topo" /><p>Desenvolvedor em Fortaleza. Automação, integrações e produtos próprios.</p></div>
    <div><h2>Navegar</h2>{navegacao.map(([nome, destino]) => <a href={destino.startsWith("#") ? a + destino : destino}>{nome}</a>)}</div>
    <div id="contatos"><h2>Contato</h2><a href={`mailto:${email}`}>{email}</a><a href={`tel:${telefoneLink}`}>{telefone}</a><span>Fortaleza, CE</span><a href={github} target="_blank" rel="noopener">GitHub ↗</a><a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></div>
  </div>
  <div class="copy"><span>© {new Date().getFullYear()} Henry Kauã. Todos os direitos reservados.</span></div>
</div></footer>
